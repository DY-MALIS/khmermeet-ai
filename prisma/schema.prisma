generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  // Optional: a user who signs up/in only via Google never sets a
  // password. Credentials login must guard against a null hash instead of
  // assuming every account has one.
  passwordHash String?
  createdAt    DateTime  @default(now())
  meetings     Meeting[]
}

model Meeting {
  id                 String                     @id @default(cuid())
  title              String
  audioUrl           String?
  transcript         String?
  summary            String?
  language           String                     @default("km")
  duration           Int                        @default(0)
  status             String                     @default("recorded")
  speakerNames       String[]                   @default([])
  smartNote          Json?
  createdById        String
  createdBy          User                       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tasks              Task[]
  decisions          Decision[]
  transcriptSegments MeetingTranscriptSegment[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
}

// Single-use, short-lived tokens for the "forgot password" flow (see
// lib/actions.ts requestPasswordReset/resetPassword) - never store the raw
// password reset capability anywhere else, and always delete/expire these.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Decision {
  id         String    @id @default(cuid())
  meetingId  String
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title      String
  ownerName  String?
  deadline   DateTime?
  status     String    @default("pending")
  sourceText String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AudioFile {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}

model Task {
  id           String    @id @default(cuid())
  meetingId    String
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  assigneeName String?
  deadline     DateTime?
  priority     String    @default("medium")
  status       String    @default("not_started")
  sourceText   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MeetingTranscriptSegment {
  id              String   @id @default(cuid())
  meetingId       String
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speakerIdentity String
  speakerName     String?
  segmentIndex    Int
  startMs         Int
  endMs           Int
  text            String
  audioUrl        String?
  languageMode    String?
  createdAt       DateTime @default(now())

  @@index([meetingId, startMs])
}

model WorkbenchProject {
  id               String             @id @default(cuid())
  meetingId        String?            @unique
  ownerId          String?
  title            String
  mediaUrl         String?
  mediaName        String?
  mediaType        String?
  mediaSize        Int?
  duration         Int?
  sourceLanguage   String             @default("auto")
  targetLanguage   String             @default("km")
  contentType      String             @default("meeting")
  status           String             @default("draft")
  progress         Int                @default(0)
  rawTranscript    String             @default("")
  cleanTranscript  String             @default("")
  translatedText   String             @default("")
  speakerNames     String[]           @default([])
  customVocabulary String[]           @default([])
  tags             String[]           @default([])
  folder           String?
  favorite         Boolean            @default(false)
  archived         Boolean            @default(false)
  summaryType      String             @default("meeting_minutes")
  summaryLength    String             @default("medium")
  summaryLanguage  String             @default("km")
  summaryResult    String             @default("")
  meetingMinutes   Json?
  errorMessage     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  versions         WorkbenchVersion[]

  @@index([ownerId, updatedAt])
  @@index([status, updatedAt])
}

// Tracks one row per AI-cost-incurring API call, so enforceRateLimit() can
// count how many a user made in a recent time window - a real signup means
// any logged-in account can hit these endpoints in a tight client-side
// loop and run up the shared OPEN_ROUTER_API_KEY bill.
model ApiUsageEvent {
  id        String   @id @default(cuid())
  userId    String
  bucket    String
  createdAt DateTime @default(now())

  @@index([userId, bucket, createdAt])
}

model WorkbenchVersion {
  id        String           @id @default(cuid())
  projectId String
  kind      String
  content   String
  metadata  Json?
  createdAt DateTime         @default(now())
  project   WorkbenchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
