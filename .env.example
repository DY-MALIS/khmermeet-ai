DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_TEXT_MODEL=openai/gpt-4o-mini
# google/chirp-3 is forced for every language, including Khmer, by product
# decision. Testing showed it does not produce accurate Khmer transcripts
# (it either hallucinates fixed fake text or rejects the request outright) -
# when that happens, transcribeAudio() automatically retries with the
# multimodal chat fallback model below instead of giving up.
OPEN_ROUTER_TRANSCRIBE_MODEL=google/chirp-3
# Used only when the primary model above returns no usable transcript
# (empty, rejected, or filtered out as a hallucination). A general
# multimodal chat model tends to understand lower-resource languages like
# Khmer better than a narrow speech-only model. gemini-2.5-pro costs more
# per request than gemini-2.5-flash but is noticeably more accurate on
# Khmer audio - worth the difference given how central transcript quality
# is to this product.
OPEN_ROUTER_TRANSCRIBE_FALLBACK_MODEL=google/gemini-2.5-pro
OPEN_ROUTER_TRANSCRIBE_TIMEOUT_MS=55000
NEXTAUTH_SECRET=
NEXTAUTH_URL="https://khmermeet-ai.vercel.app"
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Video provider. Use "livekit" for production SFU, recording, and agent workflow.
# Use "jitsi" only for free basic video-call testing without automatic recording/transcript.
NEXT_PUBLIC_VIDEO_PROVIDER=livekit

# Supabase Storage for persistent audio/video files.
# Create a private bucket in Supabase Storage, then add the service role key in Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=meeting-recordings

# Public anon key (Project Settings -> API in Supabase - safe to expose to the
# browser, unlike the service role key above). Lets long recordings upload
# directly from the browser to Supabase Storage, bypassing Vercel's 4.5MB
# request-body limit that would otherwise cap a recording to a few minutes.
# Without this, recordings fall back to going through our own server and are
# limited to short clips. No RLS policy changes needed for this to work.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: LiveKit server-side room recording (Egress) to S3-compatible storage.
# Supabase Storage S3 endpoint example: https://<project-ref>.supabase.co/storage/v1/s3
LIVEKIT_EGRESS_S3_ENDPOINT=
LIVEKIT_EGRESS_S3_REGION=
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_STUN_URL="stun:stun.l.google.com:19302"
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
